# CourseMate service image.
#
# Runs OUTSIDE Open edX (design §3.4): latency, memory, model failures and
# traffic spikes are contained in a container that can be scaled and restarted
# without touching the LMS.
#
#   docker build -f deploy/Dockerfile.service -t coursemate/service:0.1.0 .
#
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

COPY packages/coursemate-contracts /app/coursemate-contracts
COPY packages/coursemate-service   /app/coursemate-service

# Two flags, both earned the hard way on a slow link:
#
#  --no-build-isolation  uses the setuptools already in the image rather than
#      downloading one into a throwaway build env. Without it a momentary PyPI
#      failure surfaces as "Could not find a version that satisfies
#      setuptools>=68 (from versions: none)", which reads like a version
#      conflict and is actually a network error.
#  --timeout/--retries   the real failure here was
#      "ReadTimeoutError: files.pythonhosted.org: Read timed out". pip's default
#      15s timeout is optimistic on a constrained connection.
ENV PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10
RUN pip install --no-cache-dir -q --no-build-isolation \
      /app/coursemate-contracts \
      /app/coursemate-service

# Non-root: this container is reachable from the browser via the ingress path,
# so it is the most exposed process in the deployment.
RUN useradd --create-home --uid 1000 coursemate
USER coursemate

EXPOSE 8000

# Single worker on purpose. The workload is async and I/O-bound (model calls,
# retrieval), so concurrency comes from the event loop rather than from
# processes. Scale by adding replicas, not workers — a streaming endpoint holds
# a connection, and per-process memory is dominated by the reranker later.
CMD ["uvicorn", "coursemate_service.main:app", \
     "--host", "0.0.0.0", "--port", "8000", \
     "--timeout-keep-alive", "120", \
     "--no-access-log"]
