# CourseMate service image — source layer only.
#
#   # once, or whenever dependencies change:
#   docker build -f deploy/Dockerfile.deps -t coursemate/deps:1 .
#   # every code change (no network required):
#   docker build -f deploy/Dockerfile.service -t coursemate/service:0.1.0 .
#
# **Why the split.** Dependencies and source change at completely different
# rates: LiteLLM's tree moves monthly, our source moves every few minutes. Baking
# both into one image meant every one-line change re-downloaded ~200MB of wheels,
# which on this link took 10-15 minutes and failed outright often enough
# ("ReadTimeoutError: files.pythonhosted.org") to block work. Splitting them
# makes a source rebuild a file copy: seconds, and offline.
#
# This is standard layer discipline, but it is worth stating plainly because the
# first two versions of this file got it wrong in a way that only showed up as
# "the build is slow again".
FROM coursemate/deps:1

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# The base image ends with `USER coursemate`, so every RUN here would inherit a
# non-root user with no write access to site-packages — pip then fails with a
# bare exit code 1 that says nothing about permissions. Root for the install,
# dropped again before CMD.
USER root

WORKDIR /app

COPY packages/coursemate-contracts /app/coursemate-contracts
COPY packages/coursemate-service   /app/coursemate-service

# --no-deps: the base image already satisfies everything, so this must not reach
#            the network.
# --no-build-isolation: uses the setuptools already present rather than fetching
#            one, which is the other thing that turned a flaky link into a
#            misleading "no matching distribution for setuptools>=68".
RUN pip install --no-cache-dir -q --no-deps --no-build-isolation \
      /app/coursemate-contracts \
      /app/coursemate-service

USER coursemate

EXPOSE 8000

# Single worker on purpose. The workload is async and I/O-bound (model calls,
# retrieval), so concurrency comes from the event loop rather than from
# processes. Scale by adding replicas, not workers — a streaming endpoint holds
# a connection, and per-process memory is dominated by the reranker later.
CMD ["uvicorn", "coursemate_service.main:app", \
     "--host", "0.0.0.0", "--port", "8000", \
     "--timeout-keep-alive", "120", \
     "--no-access-log"]
